{
    "version": 1.0,
    "case": {
        "mesh_file": "turb_pipe.nmsh",
        "output_at_end": true,
        "output_boundary": true,
        "output_checkpoints": true,
        "checkpoint_control": "simulationtime",
        "checkpoint_value": 5.0,
        "output_directory": "data/test",
/        "restart_file": "data/test/fluid00000.chkp",
        "runtime_statistics": {
            "enabled": true
        },
        "time": {
            "end_time": 25.0,
            "variable_timestep": true,
            "target_cfl": 0.5 
        },
        "numerics": {
            "time_order": 3,
            "polynomial_order": 3,
            "dealias": true
        },
        "fluid": {
            "scheme": "pnpn",
            "Re": 5850.0,
            "wall_zone_indices": [3],
            "cyclic": false,
            "initial_condition": {
                "type": "user"
            },
            "velocity_solver": {
                "type": "coupled_cg",
                "preconditioner": {
                    "type": "jacobi"
                },
                "projection_space_size": 3,
                "absolute_tolerance": 1e-4,
                "max_iterations": 800
            },
            "pressure_solver": {
                "type": "gmres",
                "preconditioner": {
                    "type": "phmg"
                },
                "projection_space_size": 10,
                "absolute_tolerance": 1e-3,
                "max_iterations": 800
            },
            "flow_rate_force": {
                "direction": 1,
                "value": 1.0,
                "use_averaged_flow": true
            },
            "output_control": "simulationtime",
            "output_value": 5.0,
            "boundary_conditions": [
                {
                    "type": "no_slip",
                    "zone_indices": [ 3 ]
                }
            ]
        },
        "simulation_components": [
            {
                "type": "lagrangian_particles",
                "name": "tracers",
                "inertia": true,
                "log": true,
                "points_file": "particles_ic.csv",
                "output_filename": "tracers",
                "output_format": "csv",
                "snapshots_per_file": 1,
                "output_control": "simulationtime",
                "output_value": 5.0
            }
        ]
    }
}
